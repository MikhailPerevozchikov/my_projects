Атрибуты таблицы продаж
datetime --> дата и время покупки
shop --> наименование аптеки
card --> идентификатор карты покупателя
bonus_earned --> количество начисленных бонусов
bonus_spent --> количество списанных бонусов
summ --> сумма без учета скидки
summ_with_disc --> сумма с учетом скидки
doc_id --> идентификатор чека


КОГОРТНЫЙ АНАЛИЗ LTV

Выручка по каждой когорте:
WITH data_cohort AS (
    SELECT
        card,
        datetime,
        FIRST_VALUE(to_char(datetime, 'YYYY-MM')) OVER (PARTITION BY card ORDER BY datetime) AS cohort,
        EXTRACT(days FROM datetime - FIRST_VALUE(datetime) OVER (PARTITION BY card ORDER BY datetime)) AS df_days,
        summ
    FROM checks
    WHERE card LIKE '2000%'
    ORDER BY card
)
SELECT
    cohort,
    SUM(summ) AS revenue
FROM data_cohort
GROUP BY cohort
ORDER BY cohort

Выручка по каждой когорте при первой покупке:
WITH data_cohort AS (
    SELECT
        card,
        datetime,
        FIRST_VALUE(to_char(datetime, 'YYYY-MM')) OVER (PARTITION BY card ORDER BY datetime) AS cohort,
        EXTRACT(days FROM datetime - FIRST_VALUE(datetime) OVER (PARTITION BY card ORDER BY datetime)) AS df_days,
        summ
    FROM checks
    WHERE card LIKE '2000%'
    ORDER BY card
)
SELECT
    cohort,
    SUM(CASE WHEN df_days = 0 THEN summ END) AS "0_day"
FROM data_cohort
GROUP BY cohort
ORDER BY cohort

Выручка каждой когорты по интервалам:
WITH data_cohort AS (
    SELECT
        card,
        datetime,
        FIRST_VALUE(to_char(datetime, 'YYYY-MM')) OVER (PARTITION BY card ORDER BY datetime) AS cohort,
        EXTRACT(days FROM datetime - FIRST_VALUE(datetime) OVER (PARTITION BY card ORDER BY datetime)) AS df_days,
        summ
    FROM checks
    WHERE card LIKE '2000%'
    ORDER BY card
)
SELECT
    cohort,
    SUM(CASE WHEN df_days = 0 THEN summ END) AS "0_day",
    SUM(CASE WHEN df_days <= 30 THEN summ END) AS "30_day",
    SUM(CASE WHEN df_days <= 60 THEN summ END) AS "60_day",
    SUM(CASE WHEN df_days <= 90 THEN summ END) AS "90_day",
    SUM(CASE WHEN df_days <= 180 THEN summ END) AS "180_day",
    SUM(CASE WHEN df_days <= 300 THEN summ END) AS "300_day"
FROM data_cohort
GROUP BY cohort
ORDER BY cohort

Выручка каждой когорты по интервалам + количество покупателей и максимальное количество дней между первой и последней покупкой в каждой когорте:
WITH data_cohort AS (
    SELECT
        card,
        datetime,
        FIRST_VALUE(to_char(datetime, 'YYYY-MM')) OVER (PARTITION BY card ORDER BY datetime) AS cohort,
        EXTRACT(days FROM datetime - FIRST_VALUE(datetime) OVER (PARTITION BY card ORDER BY datetime)) AS df_days,
        summ
    FROM checks
    WHERE card LIKE '2000%'
    ORDER BY card
)
SELECT
    cohort,
    COUNT(DISTINCT card) AS cnt_customer,
    MAX(df_days) AS max_df_days,
    SUM(CASE WHEN df_days = 0 THEN summ END) AS "0_day",
    SUM(CASE WHEN df_days <= 30 THEN summ END) AS "30_day",
    SUM(CASE WHEN df_days <= 60 THEN summ END) AS "60_day",
    SUM(CASE WHEN df_days <= 90 THEN summ END) AS "90_day",
    SUM(CASE WHEN df_days <= 180 THEN summ END) AS "180_day",
    SUM(CASE WHEN df_days <= 300 THEN summ END) AS "300_day"
FROM data_cohort
GROUP BY cohort
ORDER BY cohort

Средняя выручка на одного покупателя в каждой когорте по интервалам:
WITH data_cohort AS (
    SELECT
        card,
        datetime,
        FIRST_VALUE(to_char(datetime, 'YYYY-MM')) OVER (PARTITION BY card ORDER BY datetime) AS cohort,
        EXTRACT(days FROM datetime - FIRST_VALUE(datetime) OVER (PARTITION BY card ORDER BY datetime)) AS df_days,
        summ
    FROM checks
    WHERE card LIKE '2000%'
    ORDER BY card
)
SELECT
    cohort,
    COUNT(DISTINCT card) AS cnt_customer,
    MAX(df_days) AS max_df_days,
    SUM(CASE WHEN df_days = 0 THEN summ END) / COUNT(DISTINCT card) AS "0_day",
    SUM(CASE WHEN df_days <= 30 THEN summ END) / COUNT(DISTINCT card) AS "30_day",
    SUM(CASE WHEN df_days <= 60 THEN summ END) / COUNT(DISTINCT card) AS "60_day",
    SUM(CASE WHEN df_days <= 90 THEN summ END) / COUNT(DISTINCT card) AS "90_day",
    SUM(CASE WHEN df_days <= 180 THEN summ END) / COUNT(DISTINCT card) AS "180_day",
    SUM(CASE WHEN df_days <= 300 THEN summ END) / COUNT(DISTINCT card) AS "300_day"
FROM data_cohort
GROUP BY cohort
ORDER BY cohort

